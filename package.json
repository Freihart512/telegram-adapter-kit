{
  "name": "telegram-adapter-kit",
  "version": "0.0.0",
  "description": "TypeScript toolkit for Telegram: runtime bot registration, subscriptions, normalized messages, MTProto (GramJS) and Bot API (grammY).",
  "keywords": [
    "telegram",
    "gramjs",
    "grammY",
    "mtproto",
    "bot-api",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node -e \"console.log('[TT-005] Build will be configured in TT-005.');\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"package.json\" \"tsconfig.json\" \"eslint.config.js\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"package.json\" \"tsconfig.json\" \"eslint.config.js\" \"vitest.config.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  }
}
