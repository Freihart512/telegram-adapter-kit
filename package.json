{
  "name": "telegram-adapter-kit",
  "version": "0.0.0",
  "description": "TypeScript toolkit for Telegram: runtime bot registration, subscriptions, normalized messages, MTProto (GramJS) and Bot API (grammY).",
  "keywords": [
    "telegram",
    "gramjs",
    "grammY",
    "mtproto",
    "bot-api",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "verify:dist": "node --input-type=module -e \"import { LIBRARY_NAME } from './dist/index.mjs'; if (LIBRARY_NAME !== 'telegram-adapter-kit') process.exit(1);\" && node -e \"const { LIBRARY_NAME } = require('./dist/index.cjs'); if (LIBRARY_NAME !== 'telegram-adapter-kit') process.exit(1);\"",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"package.json\" \"tsconfig.json\" \"eslint.config.js\" \"vitest.config.ts\" \"tsup.config.ts\" \"RELEASING.md\" \"CHANGELOG.md\" \".changeset/**/*.md\" \".github/pull_request_template.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"package.json\" \"tsconfig.json\" \"eslint.config.js\" \"vitest.config.ts\" \"tsup.config.ts\" \"RELEASING.md\" \"CHANGELOG.md\" \".changeset/**/*.md\" \".github/pull_request_template.md\"",
    "typecheck": "tsc --project tsconfig.json",
    "example:basic": "tsx examples/basic-runtime/main.ts",
    "example:mtproto": "tsx examples/mtproto-runtime/main.ts",
    "script:gramjs-session": "tsx scripts/generate-mtproto-session.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "grammy": "^1.43.0",
    "telegram": "^2.26.22"
  }
}
