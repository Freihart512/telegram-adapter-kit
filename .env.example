# =============================================================================
# Root — shared reference (copy sections into each example folder)
# Never commit real values. All `.env` files are gitignored except `.env.example`.
# =============================================================================

# --- MTProto (GramJS user session) → scripts/, examples/mtproto-runtime/ ---
# https://my.telegram.org/apps
# TG_API_ID=
# TG_API_HASH=
# TG_STRING_SESSION=          # npm run script:gramjs-session

# --- Bot API → examples/basic-runtime/ only ---
# TG_BOT_TOKEN=               # @BotFather

# --- Shared test target (both examples) ---
# t.me/c/2593336332/35 → TG_CHAT_ID=-1002593336332, TG_TOPIC_ID=35
# TG_CHAT_ID=-1002593336332
# TG_TOPIC_ID=35

# --- Optional overrides (examples) ---
# TG_BOT_ID=
# TG_BINDING_ID=
# TG_GREETING_TEXT=
